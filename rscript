Maj_needed <- function(x) {
  y <- all_districts %>% 
    filter(YEAR == x) %>% 
    arrange(PROP) %>% 
    mutate(Sum=sum(PROP)) %>% 
    mutate(id = row_number()) %>%
    mutate(nrow = max(id)) %>% 
    mutate(need = case_when(
      id <= nrow/2~ 1,
      TRUE ~ 0
    )) %>% 
    filter(need != 0) %>%
    mutate(n_seats = max(id)) %>% 
    mutate(vote = sum(PROP)) %>% 
    select(YEAR, n_seats, Sum, vote) %>% 
    unique() %>% 
    mutate(Prop = vote/Sum) 
  write_rds(y, paste0("mala2/",x,".rds"))
}


