enroll2 <- function(y){
  x <- read.delim(paste0("http://psephos.adam-carr.net/countries/a/australia/states/vic/historic/",y,"assembly.txt"))
  
  x <- as.vector(x)
  x <- str_replace_all(x, "(2 members)", "")
  x <- str_replace_all(x, "BY-ELECTIONS(,?.*)","")
  
  xl1<- str_extract_all(x, regex("(\\S+)\\s+(\\S+)\\s+(\\S+)\\s+enrolled"))
  
  
  xl2 <- xl1[[1]]
  
  
  xl3 <- str_replace_all(xl2, regex("\\W+"), " ")
  
  xl4 <- str_replace_all(xl3, " enrolled", "")
  
  n <- extract_numeric(xl4)
  
  xl5 <- str_trim(gsub("[[:digit:]]", "", xl4))
  
  xlt1 <- as_tibble(xl5,.name_repair = ~ "DISTRICT")
  
  xlt2 <- as_tibble(n,.name_repair = ~"EN") 
  
  
  t <- xlt1 %>% 
    bind_cols(xlt2) %>%
    mutate(YEAR = y)
  
  write_rds(t, paste("enrole/",y,".rds"))
}


